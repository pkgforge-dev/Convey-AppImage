diff --git a/src/client/util/util-files.vala b/src/client/util/util-files.vala
index d24194632..b92290cfc 100644
--- a/src/client/util/util-files.vala
+++ b/src/client/util/util-files.vala
@@ -6,6 +6,46 @@
 
 namespace Files {
 
+/**
+ * Returns the directory the application is installed in.
+ *
+ * This is resolved from the path of the running binary, so that the
+ * application finds its resources wherever it is installed, including
+ * inside an AppImage, which is mounted on a random directory.
+ */
+public string get_install_prefix() {
+    string? exe = null;
+    try {
+        exe = GLib.FileUtils.read_link("/proc/self/exe");
+    } catch (GLib.FileError err) {
+        // Fall back to the compiled-in prefix below.
+    }
+
+    if (exe != null) {
+        GLib.File? dir = GLib.File.new_for_path(exe).get_parent();
+        while (dir != null) {
+            if (dir.get_child("share").get_child("convey").query_exists()) {
+                return dir.get_path();
+            }
+            dir = dir.get_parent();
+        }
+    }
+
+    return Config.INSTALL_PREFIX;
+}
+
+/**
+ * Returns a path that was compiled into the application, relocated to
+ * the directory the application is actually installed in.
+ */
+public string relocate(string path) {
+    if (path.has_prefix(Config.INSTALL_PREFIX)) {
+        return get_install_prefix()
+            + path.substring(Config.INSTALL_PREFIX.length);
+    }
+    return path;
+}
+
 public const int64 KILOBYTE = 1024;
 public const int64 MEGABYTE = KILOBYTE * 1024;
 public const int64 GIGABYTE = MEGABYTE * 1024;
